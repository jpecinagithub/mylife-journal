# MyLife Journal — environment variables template
#
# DATABASE_URL
#   Neon Postgres connection string (pooled). From the Neon dashboard:
#   Project → Connection Details → connection string.
DATABASE_URL=

# BLOB_READ_WRITE_TOKEN
#   Vercel Blob store token. Created when you create a Blob store in the
#   Vercel dashboard (Storage → Blob). Read-write token.
BLOB_READ_WRITE_TOKEN=

# SESSION_SECRET
#   Random secret for HMAC session tokens. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# OWNER_PASSWORD_HASH
#   bcrypt hash of the owner password. Generate with:
#   MYLIFE_PASSWORD="your-secret" npm run hash-password
OWNER_PASSWORD_HASH=

# MAX_IMAGE_MB (optional, default 10)
#   Max accepted upload size in megabytes.
MAX_IMAGE_MB=10

# VITE_APP_NAME
#   Public app name used by the frontend.
VITE_APP_NAME=MyLife Journal
